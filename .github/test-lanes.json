{
  "extends": "workflow",
  "lanes": {
    "core": {
      "roots": [
        "package/tests/core",
        "integration_tests/core"
      ]
    }
  },
  "rules": [
    {
      "name": "python-environment",
      "when": [
        "pyproject.toml",
        "**/pyproject.toml",
        "uv.lock",
        "**/uv.lock",
        ".python-version",
        "pytest.ini",
        "**/pytest.ini",
        ".pytest.ini",
        "**/.pytest.ini",
        "pytest.toml",
        "**/pytest.toml",
        ".pytest.toml",
        "**/.pytest.toml",
        "requirements*.txt",
        "requirements*.in",
        "requirements*.lock",
        "constraints*.txt",
        "package/*requirements*.txt",
        "package/*requirements*.in",
        "poetry.lock",
        "pdm.lock",
        "pixi.lock",
        "Pipfile",
        "Pipfile.lock",
        "pylock*.toml",
        "setup.py",
        "setup.cfg",
        "tox.ini"
      ],
      "select": [
        "all"
      ],
      "reason": "the environment every lane installs; documentation/ and publish/ requirements belong to their own readers"
    },
    {
      "name": "typecheck-project",
      "when": [
        "package/src/**/*.py",
        "package/src/**/*.pyi",
        "package/shims/**/*.py",
        "package/shims/**/*.pyi",
        "package/tests/**/*.py",
        "package/tests_support/**/*.py",
        "integration_tests/**/*.py",
        "demos/**/*.py",
        "scripts/**/*.py",
        "examples/adopter/**/*.py",
        "examples/shopify_billing/**/*.py",
        "examples/checkout_tutorial/**/*.py",
        "examples/rq_tutorial/**/*.py"
      ],
      "select": [
        "lane:typecheck"
      ],
      "reason": "pyrefly checks every file in pyproject.toml's [tool.pyrefly] project-includes"
    },
    {
      "name": "adopter-handoff-scan",
      "when": [
        "examples/adopter/**/*.py"
      ],
      "select": [
        "lane:actions"
      ],
      "reason": "the check action and due-work-harness check scan every Python file in the example adopter for handoff sites"
    },
    {
      "name": "publisher-container",
      "when": [
        "publish/Dockerfile",
        "publish/Dockerfile.dockerignore",
        "publish/requirements.txt",
        "publish/render.py"
      ],
      "select": [
        "lane:actions"
      ],
      "reason": "publish/sandbox.test.cjs builds and runs the publisher container from them"
    }
  ]
}
